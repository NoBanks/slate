# Copy to .env (never commit .env)
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
SLATE_PLANNER_MODEL=glm-5.3
SLATE_VERIFIER_MODEL=qwen3.8-flash-next
SLATE_SAFETY_MODEL=nemotron-3.5-content-safety
# mock | vultr
SLATE_LLM=vultr
# local | docker | msb
SLATE_SANDBOX=msb
SLATE_PROXY_PORT=8899
SLATE_DATA_DIR=./data
# Vendor sites the agent may visit (comma separated hostnames)
SLATE_ALLOWLIST=slate-brightline.nohumannearby.com,slate-lumen.nohumannearby.com,slate-northfield.nohumannearby.com
SLATE_TASK_TIMEOUT_S=240
